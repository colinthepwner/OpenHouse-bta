{
	"schemaVersion": 1,
	"id": "openhouse",
	"version": "${version}",
	"name": "OpenHouse",
	"description": "Play with friends using a room code. Credits: webrtc-java by devopvoid, built on Google's WebRTC; PeerJS's free server for finding rooms; and the official Better than Adventure server for hosting.",
	"authors": [
		"colin"
	],
	"contact": {
		"homepage": "https://github.com/colinthepwner/OpenHouse-bta",
		"sources": "https://github.com/colinthepwner/OpenHouse-bta"
	},
	"license": "CC0-1.0",
	"icon": "icon.png",
	"environment": "*",
	"entrypoints": {
		"preLaunch": [
			"openhouse.mod.OpenHousePreLaunch"
		],
		"client": [
			"openhouse.mod.OpenHouseMod"
		],
		"server": [
			"openhouse.mod.server.OpenHouseServer"
		]
	},
	"mixins": [
		"openhouse.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.15.0",
		"minecraft": "*",
		"java": ">=${java}"
	}
}
