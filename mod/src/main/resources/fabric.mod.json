{
	"schemaVersion": 1,
	"id": "openhouse",
	"version": "${version}",
	"name": "OpenHouse",
	"description": "Play BTA! with your friends using a room code. No port forwarding.\\n\\nMade with \\u2764\\ufe0f by @colinthepwner\\n\\nThanks to webrtc-java, PeerJS and the BTA! team.",
	"authors": [
		"colinthepwner"
	],
	"contact": {
		"homepage": "https://github.com/colinthepwner/OpenHouse-bta",
		"sources": "https://github.com/colinthepwner/OpenHouse-bta"
	},
	"license": "CC0-1.0",
	"icon": "icon.png",
	"environment": "*",
	"entrypoints": {
		"preLaunch": [
			"openhouse.gate.GatePreLaunch"
		],
		"client": [
			"openhouse.gate.GateClient"
		],
		"server": [
			"openhouse.gate.GateServer"
		]
	},
	"mixins": [
		"openhouse.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.15.0",
		"minecraft": "*",
		"java": ">=${java}"
	}
}
